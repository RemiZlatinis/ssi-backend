# ==============================================================================
# SSI BACKEND - SHARED DEVELOPMENT DEFAULTS
# ==============================================================================
# These variables are automatically loaded IF the ENVIRONMENT is NOT "production".
# ==============================================================================
# If you need to override any of these values, you can do so in your local .env file.
# ==============================================================================
# If you are running the backend on a remote machine, you must use SSH port
# forwarding to access the backend and frontend from your local machine
# because of OAuth2 redirect URI restrictions (only "localhost" is allowed):
# ssh -L 8000:127.0.0.1:8000 -L 8081:127.0.0.1:8081 remi@192.168.1.3
#
# Also make sure you have override and added the 192.168.x.x IP on the ALLOWED_HOSTS,
# CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS in the .env file.
# ==============================================================================

# --- GENERAL ---
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=django-insecure-default-for-development

# --- NETWORK ---
HOST=localhost
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CSRF_TRUSTED_ORIGINS=http://localhost:8081

# --- DATABASE ---
# Shared development defaults. Consumed by both the postgres container (via
# env_file in docker-compose.yml) and Django (as fallback components).
POSTGRES_DB=ssi-backend
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- REDIS / CHANNELS ---
REDIS_URL=redis://valkey:6379/0

# --- LOGGING ---
LOG_LEVEL=DEBUG

# --- INITIAL SETUP ONLY ---
# Credentials for the first administrator (used during bootstrap)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
